# 复制为 .env 并填入真实值
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# RAG Embedding（Day 6）
EMBEDDING_MODEL=text-embedding-3-small
# Embedding 模式（三选一）：
# 1) API embedding（需服务商支持）
# 2) USE_LOCAL_EMBEDDING=1 本地模型（需能访问 HuggingFace 或镜像）
# 3) USE_KEYWORD_FALLBACK=1 离线关键词检索（DeepSeek 用户推荐）
USE_LOCAL_EMBEDDING=0
USE_KEYWORD_FALLBACK=1
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 1=LangChain Agent（默认），0=手写 ReAct
USE_LANGCHAIN=1
